<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml: builds the BranchBook API, the Spring Boot application that also serves the React app.

    ./mvnw test             unit tests only; no Docker needed.
    ./mvnw verify           unit tests, then integration tests (*IT) on a real PostgreSQL 17 through
                            Testcontainers (needs Docker), the formatting check and the coverage report.
    ./mvnw spotless:apply   formats every Java file with google-java-format.

  The build fails on any compiler warning, on missing or broken Javadoc (CONTRIBUTING.md) and on unformatted code.
  Versions the Spring Boot parent does not manage are pinned in <properties> and listed in README.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>za.co.fynbos</groupId>
  <artifactId>branchbook</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>BranchBook</name>
  <description>Branch appointment booking for the fictional Fynbos Bank</description>
  <url>https://github.com/KatlehoKomeke/Appointment-Booking-System</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Katleho Komeke</name>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/KatlehoKomeke/Appointment-Booking-System</url>
    <connection>scm:git:https://github.com/KatlehoKomeke/Appointment-Booking-System.git</connection>
  </scm>

  <properties>
    <!-- Java 25 LTS. The day-0 spike passed on it, so the Java 21 fallback was not needed. -->
    <java.version>25</java.version>
    <!-- Build plugins that the Spring Boot parent does not manage. -->
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
    <!-- 1.37.0 fails inside Spotless 3.10.4 (its Markdown Javadoc support cannot load), so 1.36.0 is pinned. -->
    <google-java-format.version>1.36.0</google-java-format.version>
    <!-- Generates the OpenAPI document (docs/openapi.yaml) and Swagger UI; the Spring Boot 4 line. -->
    <springdoc.version>3.2.0</springdoc.version>
    <!-- Parses and checks South African mobile numbers (BR-19). Not managed by Spring Boot; Dependabot bumps it, and
         MobileNumberTest asserts the number types the rules depend on, so a metadata change cannot slip through. -->
    <libphonenumber.version>9.0.41</libphonenumber.version>
    <!-- The AWS SDK for Java v2, for the real SMS gateway (AWS End User Messaging SMS). Pinned to the newest release that
         was at least two weeks old when it was added (2.55.15, published 2026-10-12): the project waits two weeks
         before taking a new release, so a broken or withdrawn one is caught upstream first. -->
    <aws-sdk.version>2.55.15</aws-sdk.version>
    <!-- The AWS Advanced JDBC Wrapper, whose iam plugin signs in to RDS with IAM database authentication. 4.5.0,
         published 2026-10-14, was the newest release at least two weeks old when it was added. -->
    <aws-advanced-jdbc-wrapper.version>4.5.0</aws-advanced-jdbc-wrapper.version>
    <!-- Security fixes ahead of Spring Boot. The image scan fails the build on a fixable CRITICAL or HIGH finding, and
         Spring Boot 4.1.1 manages Tomcat 11.0.24, Jackson 3.1.5 and Jackson 2.21.5, which have such findings. These
         override its managed versions with patch releases of the same lines, each at least two weeks old when pinned
         (Tomcat 11.0.25 published 2026-08-12, both Jackson BOMs 2026-09-21). Spring Boot 4.1.2, which would bring
         them, was too new to take. Drop each property once the Spring Boot version in <parent> manages this version
         or a later one. -->
    <tomcat.version>11.0.25</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
    <!-- Test libraries that the Spring Boot parent does not manage. -->
    <archunit.version>1.5.1</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Keeps every AWS SDK module on the one pinned version. -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Runtime -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Serves the metrics at /actuator/prometheus in Prometheus's text format (FR-30); the version is managed by
         Spring Boot. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <!-- Compile scope only so booking.infrastructure can read a failed statement's SQLSTATE and constraint name
           from the driver's own exception (ConstraintViolationTranslator); nothing else imports it. -->
    </dependency>
    <!-- South African mobile numbers: the six documented input formats, and the MOBILE type check (BR-19). -->
    <dependency>
      <groupId>com.googlecode.libphonenumber</groupId>
      <artifactId>libphonenumber</artifactId>
      <version>${libphonenumber.version}</version>
    </dependency>
    <!-- The OpenAPI document and Swagger UI, generated from the controllers (ADR-0005). -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <!-- Sends a real SMS through AWS End User Messaging SMS where branchbook.sms.gateway is aws (AwsSmsGateway). The
         SDK's own HTTP clients, Apache (4 and 5) and Netty, are left out: one synchronous call needs no more than
         the JDK's URLConnection client below, which keeps the jar lean. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>pinpointsmsvoicev2</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>
    <!-- In AWS the application connects to RDS as the runtime role with IAM database authentication, so no database
         password for it exists: DB_URL is jdbc:aws-wrapper:postgresql://...?wrapperPlugins=iam, and the wrapper's
         driver, software.amazon.jdbc.Driver, asks RDS's utilities for a short-lived token in place of a password and
         hands the connection to PostgreSQL's driver. A plain jdbc:postgresql: URL, as locally, in CI and in the
         migration task, never touches it (AwsJdbcWrapperIT). The wrapper's own AWS dependencies are optional, so the
         one its iam plugin needs, the SDK's rds module, is added below on the pinned SDK version. -->
    <dependency>
      <groupId>software.amazon.jdbc</groupId>
      <artifactId>aws-advanced-jdbc-wrapper</artifactId>
      <version>${aws-advanced-jdbc-wrapper.version}</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>rds</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Enforces the module and layer rules (ArchitectureTest). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- A fixed jar name, so the Dockerfile does not change with every version. -->
    <finalName>branchbook</finalName>

    <plugins>
      <!-- Fails fast, with a clear message, on a JDK older than the one the code is written for. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[${java.version},)</version>
                  <message>BranchBook needs JDK ${java.version} or later. Point JAVA_HOME at one (see api/README.md).</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <!-- Production code only; tests compile with the defaults. -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <annotationProcessorPaths>
                <!-- Generates metadata for @ConfigurationProperties, so IDEs can complete and check them. -->
                <path>
                  <groupId>org.springframework.boot</groupId>
                  <artifactId>spring-boot-configuration-processor</artifactId>
                </path>
              </annotationProcessorPaths>
              <compilerArgs>
                <!-- Every compiler warning is on. "processing" only reports annotations no processor claimed. -->
                <arg>-Xlint:all,-processing</arg>
                <!-- Javadoc lint: public and protected code must be documented, with valid references and HTML. -->
                <arg>-Xdoclint:all/protected</arg>
                <!-- Any warning, from either check above, fails the build. -->
                <arg>-Werror</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- Writes META-INF/build-info.properties, which /actuator/info reports as the running version. -->
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Sets the property ${org.mockito:mockito-core:jar} to the Mockito jar's path, for the test JVMs below. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Unit tests (*Test). Mockito is loaded as a Java agent at startup, as Mockito documents for Java 21 and
        later, because the JDK is phasing out agents that attach to a running JVM. @{argLine} keeps JaCoCo's agent.
        -Xshare:off stops the JVM warning that class sharing is limited once Mockito extends the boot class path.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
        </configuration>
      </plugin>

      <!--
        Integration tests (*IT), run after packaging. They start PostgreSQL 17 in Docker through Testcontainers.
        The executions come from the Spring Boot parent; the agents are the same as for the unit tests.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
        </configuration>
      </plugin>

      <!-- Checks during verify that every Java file is formatted; `./mvnw spotless:apply` fixes any that are not. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Measures test coverage across unit and integration tests and writes target/site/jacoco/index.html during
        verify. It is a report, not a gate: the tests are judged by the rules they prove (docs/domain-rules.md).
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
