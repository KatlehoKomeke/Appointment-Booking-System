{
  "namePrefix": "branchbook",
  "github": {
    "repository": "KatlehoKomeke/Appointment-Booking-System",
    "ownerId": "88820937",
    "repositoryId": "1423867330"
  },
  "accountRegion": "us-east-1",
  "workloadRegion": "af-south-1",
  "budget": {
    "monthlyUsd": 350,
    "alertThresholdsPercent": [50, 80, 100]
  },
  "deploy": {
    "maxSessionMinutes": 60,
    "cdkBootstrapQualifier": "hnb659fds",
    "imageRepositoryName": "branchbook",
    "environments": {
      "staging": {
        "githubEnvironment": "staging",
        "resourcePrefix": "branchbook-staging",
        "syntheticTrafficSecretName": "branchbook-staging/synthetic-traffic-token"
      },
      "production": {
        "githubEnvironment": "production",
        "resourcePrefix": "branchbook"
      }
    }
  },
  "guardrails": {
    "appStackNames": [
      "BranchbookRegistry",
      "BranchbookData",
      "BranchbookApp",
      "BranchbookRelease",
      "BranchbookStagingData",
      "BranchbookStagingApp",
      "BranchbookStagingRelease"
    ],
    "auditLogRetentionDays": 365,
    "auditLogNoncurrentVersionDays": 30,
    "guardDuty": {
      "findingPublishingFrequency": "FIFTEEN_MINUTES",
      "features": {
        "S3_DATA_EVENTS": "ENABLED",
        "RDS_LOGIN_EVENTS": "ENABLED",
        "LAMBDA_NETWORK_LOGS": "ENABLED",
        "EBS_MALWARE_PROTECTION": "DISABLED",
        "EKS_AUDIT_LOGS": "DISABLED",
        "RUNTIME_MONITORING": "DISABLED"
      }
    },
    "config": {
      "recordingFrequency": "CONTINUOUS",
      "snapshotDeliveryFrequency": "TwentyFour_Hours"
    }
  }
}
