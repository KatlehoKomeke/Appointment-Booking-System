# .env.example
# Overrides for `make up` (docker compose), kept in .env, which git ignores.
#
# Only DB_PASSWORD is required, and `make up` writes a random one to .env the first time, so there is usually nothing
# to do. Copy a line from here into .env only to change a value. Real credentials never go in this file, in .env, or
# anywhere else in the repository: staging and production read them from AWS at runtime (docs/configuration.md).

# Host port for the app, bound to 127.0.0.1.
APP_PORT=8080

# Credentials of the throwaway PostgreSQL container that docker compose starts. Not used anywhere else.
# Changing them after the first `make up` needs `make down` first, because the database keeps the old ones. A copy
# started before DB_PASSWORD became required also needs `make down` once, for the same reason.
DB_USER=branchbook
# Required; no default is committed. `make up` generates one (openssl rand -hex 24) when .env has none.
DB_PASSWORD=
