# .env.example
# Template for local development with docker compose.
#
# Copy it to .env (which git ignores) only if you need to change a value.
# Every value here is a local-development placeholder. Real credentials never go in this file,
# in .env, or anywhere else in the repository: hosted environments read them from
# AWS Secrets Manager at runtime (see docs/adr/0006-hosted-demo-on-aws-with-cdk.md).

# Host port for the app, bound to 127.0.0.1 by docker compose.
APP_PORT=8080

# Spring profile: "docker" under compose, "dev" when running the API from an IDE.
SPRING_PROFILES_ACTIVE=docker

# The throwaway PostgreSQL container that docker compose starts. Not used anywhere else.
DB_URL=jdbc:postgresql://db:5432/branchbook
DB_USER=branchbook
DB_PASSWORD=local-dev-only-change-me

# Base URL used in the SMS "manage" link. Must be 28 characters or fewer, including the scheme,
# or the application refuses to start (the SMS must fit one 160-character segment).
BRANCHBOOK_BOOKING_PUBLIC_BASE_URL=http://localhost:8080
