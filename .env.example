# .env.example
# Optional overrides for `make up` (docker compose).
#
# Nothing here is required: compose.yaml has a default for every value. Copy this file to .env (which git ignores)
# only to change one. Every value is a local-development placeholder. Real credentials never go in this file, in
# .env, or anywhere else in the repository: the hosted demo reads them from AWS Secrets Manager at runtime
# (see docs/adr/0006-hosted-demo-on-aws-with-cdk.md).

# Host port for the app, bound to 127.0.0.1.
APP_PORT=8080

# Credentials of the throwaway PostgreSQL container that docker compose starts. Not used anywhere else.
# Changing them after the first `make up` needs `make down` first, because the database keeps the old ones.
DB_USER=branchbook
DB_PASSWORD=local-dev-only-change-me
