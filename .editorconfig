# .editorconfig
# Shared editor settings. Java follows google-java-format (2-space indent), which Spotless enforces in CI.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,kt}]
indent_size = 2
max_line_length = 100

[*.{xml,sql}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
